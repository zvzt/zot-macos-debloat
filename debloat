    print(BANNER)
    print("System check")
    print(f"  Version: {VERSION}")
    print(f"  Python:      {platform.python_version()}")
    sw = capture(["sw_vers", "-productVersion"])
    print(f"  macOS:       {(sw.stdout or 'unknown').strip()}")
