#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import platform
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Optional

VERSION = "2.1.0"
UID = os.getuid()
BASE_DIR = Path(__file__).resolve().parent
PRESETS_DIR = BASE_DIR / "presets"
STATE_DIR = BASE_DIR / "state"
CONFIG_FILE = BASE_DIR / "config.json"
STATE_FILE = STATE_DIR / "disabled-services.txt"
SPOTLIGHT_STATE_FILE = STATE_DIR / "spotlight-changed.txt"

PRESET_FILES = {
    "balanced": PRESETS_DIR / "balanced.txt",
    "aggressive": PRESETS_DIR / "aggressive.txt",
    "siri": PRESETS_DIR / "siri.txt",
    "intelligence": PRESETS_DIR / "apple-intelligence.txt",
}

DEFAULT_CONFIG = {
    "profile": "balanced",
    "siri": "keep",
    "intelligence": "keep",
    "spotlight": "keep",
}

AGENT_DIRS = (
    Path("/System/Library/LaunchAgents"),
    Path("/Library/LaunchAgents"),
    Path("/Library/Apple/System/Library/LaunchAgents"),
    Path("/System/Cryptexes/App/System/Library/LaunchAgents"),
)
DAEMON_DIRS = (
    Path("/System/Library/LaunchDaemons"),
    Path("/Library/LaunchDaemons"),
    Path("/Library/Apple/System/Library/LaunchDaemons"),
    Path("/System/Cryptexes/App/System/Library/LaunchDaemons"),
)

BANNER = r"""
macOS Debloat
=================
"""

HOME = Path.home()
CLEAN_PATH_TARGETS = {
    "caches": ("User app caches", HOME / "Library" / "Caches", "Rebuildable app cache files; apps may reopen a little slower once."),
    "logs": ("User logs", HOME / "Library" / "Logs", "Application logs and user diagnostic logs."),
    "trash": ("Trash", HOME / ".Trash", "Permanently empties the current user Trash."),
    "xcode": ("Xcode DerivedData", HOME / "Library" / "Developer" / "Xcode" / "DerivedData", "Derived build products that Xcode can regenerate."),
}
CLEAN_COMMAND_DESCRIPTIONS = {
    "homebrew": ("Homebrew cleanup", "Removes stale Homebrew versions and cached downloads."),
    "pip": ("Python pip cache", "Removes pip download and wheel caches."),
    "npm": ("npm cache", "Removes npm package cache data."),
    "pnpm": ("pnpm store prune", "Removes unreferenced pnpm store packages."),
    "yarn": ("Yarn cache", "Removes Yarn package cache data."),
    "quicklook": ("Quick Look cache", "Resets cached thumbnails and previews."),
}


def run(cmd: list[str], quiet: bool = True) -> subprocess.CompletedProcess:
    kwargs = {"check": False, "text": True}
    if quiet:
        kwargs["stdout"] = subprocess.DEVNULL
        kwargs["stderr"] = subprocess.DEVNULL
    return subprocess.run(cmd, **kwargs)


def capture(cmd: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, text=True, capture_output=True)


def privileged(cmd: list[str], quiet: bool = True) -> subprocess.CompletedProcess:
    if os.geteuid() == 0:
        return run(cmd, quiet=quiet)
    return run(["sudo", *cmd], quiet=quiet)


def read_labels(path: Path) -> list[str]:
    if not path.exists():
        return []
    labels: list[str] = []
    for raw in path.read_text(errors="ignore").splitlines():
        line = raw.split("#", 1)[0].strip()
        if line:
            labels.append(line)
    return list(dict.fromkeys(labels))


def load_config() -> dict[str, str]:
    config = dict(DEFAULT_CONFIG)
    if CONFIG_FILE.exists():
        try:
            data = json.loads(CONFIG_FILE.read_text())
            if isinstance(data, dict):
                config.update({k: str(v) for k, v in data.items() if k in config})
        except (OSError, json.JSONDecodeError):
            pass
    if config["profile"] not in {"balanced", "aggressive"}:
        config["profile"] = "balanced"
    if config["siri"] not in {"keep", "disable"}:
        config["siri"] = "keep"
    if config["intelligence"] not in {"keep", "disable"}:
        config["intelligence"] = "keep"
    if config["spotlight"] not in {"keep", "off"}:
        config["spotlight"] = "keep"
    return config


def save_config(config: dict[str, str]) -> None:
    BASE_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")


def prompt_choice(title: str, choices: list[tuple[str, str]], default: str) -> str:
    print()
    print(title)
    for key, description in choices:
        marker = " [default]" if key == default else ""
        print(f"  {key}) {description}{marker}")
    while True:
        answer = input("> ").strip().lower()
        if not answer:
            return default
        for key, _ in choices:
            if answer == key.lower():
                return key
        print("Choose one of: " + ", ".join(key for key, _ in choices))


def configure(*, defaults: bool = False, apply_after: bool = True) -> None:
    config = load_config()
    if defaults:
        config = dict(DEFAULT_CONFIG)
    else:
        print(BANNER)
        print("Configuration wizard")
        print("Safe defaults keep Siri, Apple Intelligence, and Spotlight enabled.")
        profile = prompt_choice(
            "Optimization profile:",
            [("balanced", "Balanced - lower-risk background cleanup for most Macs"),
             ("aggressive", "Aggressive - disables more optional Apple features/services")],
            config["profile"],
        )
        siri = prompt_choice(
            "Siri:",
            [("keep", "Keep Siri enabled"),
             ("disable", "Disable Siri background services")],
            config["siri"],
        )
        intelligence = prompt_choice(
            "Apple Intelligence:",
            [("keep", "Keep Apple Intelligence enabled"),
             ("disable", "Disable Apple Intelligence background services")],
            config["intelligence"],
        )
        spotlight = prompt_choice(
            "Spotlight indexing:",
            [("keep", "Keep Spotlight indexing enabled/recommended"),
             ("off", "Disable indexing on the startup volume; Raycast is recommended as a launcher alternative")],
            config["spotlight"],
        )
        config.update({
            "profile": profile,
            "siri": siri,
            "intelligence": intelligence,
            "spotlight": spotlight,
        })
    save_config(config)
    print()
    print("Saved configuration:")
    print_config(config)
    if apply_after:
        print()
        apply()


def print_config(config: Optional[dict[str, str]] = None) -> None:
    config = config or load_config()
    print(f"  Profile:            {config['profile']}")
    print(f"  Siri:               {config['siri']}")
    print(f"  Apple Intelligence: {config['intelligence']}")
    print(f"  Spotlight:          {config['spotlight']}")


def labels_for_group(group: str) -> list[str]:
    path = PRESET_FILES[group]
    return read_labels(path)


def desired_labels(config: Optional[dict[str, str]] = None) -> list[str]:
    config = config or load_config()
    labels: list[str] = []
    labels.extend(labels_for_group("balanced"))
    if config["profile"] == "aggressive":
        labels.extend(labels_for_group("aggressive"))
    if config["siri"] == "disable":
        labels.extend(labels_for_group("siri"))
    if config["intelligence"] == "disable":
        labels.extend(labels_for_group("intelligence"))
    return list(dict.fromkeys(labels))


def user_domain() -> str:
    return f"gui/{UID}"


def registered(domain: str, label: str) -> bool:
    return run(["launchctl", "print", f"{domain}/{label}"]).returncode == 0


def direct_plist_kind(label: str) -> set[str]:
    kinds: set[str] = set()
    for directory in AGENT_DIRS:
        if (directory / f"{label}.plist").exists():
            kinds.add("user")
    for directory in DAEMON_DIRS:
        if (directory / f"{label}.plist").exists():
            kinds.add("system")
    return kinds


def domains_for(label: str) -> set[str]:
    domains: set[str] = set()
    if registered(user_domain(), label):
        domains.add("user")
    if registered("system", label):
        domains.add("system")
    if not domains:
        domains |= direct_plist_kind(label)
    return domains


def actual_disabled(domain: str, label: str) -> bool:
    result = capture(["launchctl", "print-disabled", domain])
    if result.returncode != 0 or not result.stdout:
        return False
    pattern = rf'"{re.escape(label)}"\s*=>\s*(?:true|disabled)\b'
    return re.search(pattern, result.stdout, re.IGNORECASE) is not None


def disable_user(label: str) -> bool:
    domain = user_domain()
    result = run(["launchctl", "disable", f"{domain}/{label}"])
    run(["launchctl", "bootout", f"{domain}/{label}"])
    return result.returncode == 0


def disable_system(label: str) -> bool:
    result = privileged(["launchctl", "disable", f"system/{label}"])
    privileged(["launchctl", "bootout", f"system/{label}"])
    return result.returncode == 0


def enable_user(label: str) -> None:
    run(["launchctl", "enable", f"{user_domain()}/{label}"])


def enable_system(label: str) -> None:
    privileged(["launchctl", "enable", f"system/{label}"])


def encode_state(kind: str, label: str) -> str:
    return f"{kind}|{label}"


def decode_state(entry: str) -> tuple[Optional[str], str]:
    if "|" not in entry:
        return None, entry
    kind, label = entry.split("|", 1)
    if kind not in {"user", "system"}:
        return None, entry
    return kind, label


def read_state() -> set[str]:
    return set(read_labels(STATE_FILE)) if STATE_FILE.exists() else set()


def save_state(entries: set[str]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    text = "\n".join(sorted(entries))
    STATE_FILE.write_text(text + ("\n" if text else ""))


def restore_entry(entry: str) -> None:
    kind, label = decode_state(entry)
    if kind == "user":
        enable_user(label)
    elif kind == "system":
        enable_system(label)
    else:
        domains = domains_for(label)
        if "user" in domains:
            enable_user(label)
        if "system" in domains:
            enable_system(label)


def spotlight_status_text() -> str:
    result = capture(["mdutil", "-s", "/"])
    text = (result.stdout or result.stderr or "").strip()
    return text or "Spotlight status unavailable"


def spotlight_is_enabled() -> Optional[bool]:
    text = spotlight_status_text().lower()
    if "indexing enabled" in text:
        return True
    if "indexing disabled" in text:
        return False
    return None


def apply_spotlight(config: dict[str, str], *, quiet: bool = False) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    changed_by_tool = SPOTLIGHT_STATE_FILE.exists()
    if config["spotlight"] == "off":
        enabled = spotlight_is_enabled()
        if enabled is True:
            result = privileged(["mdutil", "-i", "off", "/"], quiet=quiet)
            if result.returncode == 0:
                SPOTLIGHT_STATE_FILE.write_text("changed-from-enabled\n")
                if not quiet:
                    print("Spotlight indexing disabled on the startup volume.")
        elif enabled is False and not quiet:
            print("Spotlight indexing was already disabled; The tool left that state alone.")
    elif changed_by_tool:
        result = privileged(["mdutil", "-i", "on", "/"], quiet=quiet)
        if result.returncode == 0:
            try:
                SPOTLIGHT_STATE_FILE.unlink()
            except OSError:
                pass
            if not quiet:
                print("Spotlight indexing restored because this tool had disabled it.")


def apply(*, quiet: bool = False, dry_run: bool = False) -> None:
    config = load_config()
    desired = set(desired_labels(config))
    missing_presets = [str(path) for path in PRESET_FILES.values() if not path.exists()]
    if missing_presets:
        print("Missing preset files:")
        for path in missing_presets:
            print(f"  {path}")
        sys.exit(1)

    previous_state = read_state()
    managed = set(previous_state)
    removed_entries = {entry for entry in managed if decode_state(entry)[1] not in desired}

    if dry_run:
        print(BANNER)
        print("Dry run - no changes will be made.")
        print_config(config)
        print()
        print(f"Desired launchd labels: {len(desired)}")
        for label in sorted(desired):
            domains = domains_for(label)
            where = ",".join(sorted(domains)) if domains else "not-present"
            print(f"  {where:12} {label}")
        print()
        print(f"Would restore removed managed targets: {len(removed_entries)}")
        print(f"Spotlight mode: {config['spotlight']}")
        return

    if removed_entries and not quiet:
        print(f"Restoring {len(removed_entries)} targets no longer selected...")
    for entry in sorted(removed_entries):
        restore_entry(entry)
        managed.discard(entry)

    unavailable: list[str] = []
    changed_now = 0
    already_managed = 0
    preserved_external = 0

    if not quiet:
        print(f"Applying {config['profile']} profile ({len(desired)} labels)...")

    for label in sorted(desired):
        domains = domains_for(label)
        if not domains:
            unavailable.append(label)
            continue
        for kind in sorted(domains):
            domain = user_domain() if kind == "user" else "system"
            entry = encode_state(kind, label)
            if entry in managed:
                already_managed += 1
                if not actual_disabled(domain, label):
                    if kind == "user":
                        disable_user(label)
                    else:
                        disable_system(label)
                continue
            if actual_disabled(domain, label):
                preserved_external += 1
                continue
            changed = disable_user(label) if kind == "user" else disable_system(label)
            if changed:
                managed.add(entry)
                changed_now += 1

    save_state(managed)
    apply_spotlight(config, quiet=quiet)

    if quiet:
        return

    print(BANNER)
    print_config(config)
    print()
    print(f"Labels selected:              {len(desired)}")
    print(f"New launchd changes:          {changed_now}")
    print(f"Previously managed targets:   {already_managed}")
    print(f"Already disabled by user/app: {preserved_external}")
    print(f"Not present on this macOS:    {len(unavailable)}")
    print(f"Recorded targets:         {len(managed)}")
    print()
    print("This tool records only launchd targets it actually changed, so restore avoids")
    print("re-enabling services that were already disabled before macOS Debloat touched them.")
    print()
    print("Restart macOS once after the first install or major profile change.")


def reapply(kind: str) -> None:
    desired = desired_labels()
    for label in desired:
        domains = domains_for(label)
        if kind not in domains:
            continue
        if kind == "user":
            disable_user(label)
        else:
            disable_system(label)


def restore() -> None:
    state = read_state()
    if not state and not SPOTLIGHT_STATE_FILE.exists():
        print("No managed changes are recorded.")
        return
    if state:
        print(f"Restoring {len(state)} managed launchd targets...")
        for entry in sorted(state):
            restore_entry(entry)
        save_state(set())
    if SPOTLIGHT_STATE_FILE.exists():
        result = privileged(["mdutil", "-i", "on", "/"], quiet=False)
        if result.returncode == 0:
            try:
                SPOTLIGHT_STATE_FILE.unlink()
            except OSError:
                pass
            print("Spotlight indexing restored.")
    print("managed changes were restored.")
    print("Restart macOS to allow services to return normally.")


def status() -> None:
    config = load_config()
    desired = desired_labels(config)
    user_disabled = 0
    system_disabled = 0
    present = 0
    for label in desired:
        domains = domains_for(label)
        if domains:
            present += 1
        if "user" in domains and actual_disabled(user_domain(), label):
            user_disabled += 1
        if "system" in domains and actual_disabled("system", label):
            system_disabled += 1
    print(BANNER)
    print(f"Version: {VERSION}")
    print_config(config)
    print()
    print(f"Selected labels:         {len(desired)}")
    print(f"Present on this Mac:     {present}")
    print(f"User-domain disabled:    {user_disabled}")
    print(f"System-domain disabled:  {system_disabled}")
    print(f"Recorded targets:    {len(read_state())}")
    print()
    print("Spotlight:")
    print("  " + spotlight_status_text().replace("\n", "\n  "))


def list_services() -> None:
    config = load_config()
    groups = ["balanced"]
    if config["profile"] == "aggressive":
        groups.append("aggressive")
    if config["siri"] == "disable":
        groups.append("siri")
    if config["intelligence"] == "disable":
        groups.append("intelligence")
    seen: set[str] = set()
    for group in groups:
        print(f"[{group}]")
        for label in labels_for_group(group):
            if label in seen:
                continue
            seen.add(label)
            domains = domains_for(label)
            where = ",".join(sorted(domains)) if domains else "not-present"
            print(f"  {where:12} {label}")
        print()


