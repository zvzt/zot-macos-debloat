    checks = {
        "launchctl": Path("/bin/launchctl").exists(),
        "mdutil": Path("/usr/bin/mdutil").exists(),
        "config": CONFIG_FILE.exists(),
        "balanced preset": PRESET_FILES["balanced"].exists(),
        "aggressive preset": PRESET_FILES["aggressive"].exists(),
        "Siri preset": PRESET_FILES["siri"].exists(),
        "Apple Intelligence preset": PRESET_FILES["intelligence"].exists(),
    }
    for name, ok in checks.items():
        print(f"  {'OK' if ok else 'MISSING':7} {name}")
    print()
    print("Configuration:")
